{{ 'section-trust-signals.css' | asset_url | stylesheet_tag }}

<div class="trust-signals-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="trust-signals-grid">
      <div class="trust-signal-item">
        <div class="trust-signal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <div class="trust-signal-content">
          <h3 class="trust-signal-title">{{ section.settings.item_1_title | default: 'Soft Comfort' | escape }}</h3>
          <p class="trust-signal-desc">{{ section.settings.item_1_desc | default: 'Thoughtfully made for cozy, everyday comfort.' | escape }}</p>
        </div>
      </div>

      <div class="trust-signal-item">
        <div class="trust-signal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="trust-signal-content">
          <h3 class="trust-signal-title">{{ section.settings.item_2_title | default: 'Custom Care' | escape }}</h3>
          <p class="trust-signal-desc">{{ section.settings.item_2_desc | default: 'Each design is crafted to match your idea with attention to detail.' | escape }}</p>
        </div>
      </div>

      <div class="trust-signal-item">
        <div class="trust-signal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="trust-signal-content">
          <h3 class="trust-signal-title">{{ section.settings.item_3_title | default: 'Lasting Quality' | escape }}</h3>
          <p class="trust-signal-desc">{{ section.settings.item_3_desc | default: 'Carefully created to feel beautiful, durable, and gift-worthy.' | escape }}</p>
        </div>
      </div>

      <div class="trust-signal-item">
        <div class="trust-signal-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="trust-signal-content">
          <h3 class="trust-signal-title">{{ section.settings.item_4_title | default: 'Free Shipping' | escape }}</h3>
          <p class="trust-signal-desc">{{ section.settings.item_4_desc | default: 'Free shipping to U.S. & Canada. $5.99 USD worldwide.' | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Signals",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Item 1 Title",
      "default": "Soft Comfort"
    },
    {
      "type": "text",
      "id": "item_1_desc",
      "label": "Item 1 Description",
      "default": "Thoughtfully made for cozy, everyday comfort."
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Item 2 Title",
      "default": "Custom Care"
    },
    {
      "type": "text",
      "id": "item_2_desc",
      "label": "Item 2 Description",
      "default": "Each design is crafted to match your idea with attention to detail."
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Item 3 Title",
      "default": "Lasting Quality"
    },
    {
      "type": "text",
      "id": "item_3_desc",
      "label": "Item 3 Description",
      "default": "Carefully created to feel beautiful, durable, and gift-worthy."
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Item 4 Title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "item_4_desc",
      "label": "Item 4 Description",
      "default": "Free shipping to U.S. & Canada. $5.99 USD worldwide."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Trust Signals"
    }
  ]
}
{% endschema %}
