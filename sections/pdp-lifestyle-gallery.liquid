{{ 'section-pdp-lifestyle-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'Lifestyle inspiration'
  assign heading = section.settings.heading | default: 'See how our bedding styles real homes'
-%}

<div class="pdp-lifestyle-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="pdp-lifestyle-header">
      <p class="pdp-lifestyle-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="pdp-lifestyle-heading">{{ heading | escape }}</h2>
    </div>

    <div class="pdp-lifestyle-track">
      {%- for block in section.blocks -%}
        <div class="pdp-lifestyle-card" {{ block.shopify_attributes }}>
          <div class="pdp-lifestyle-media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'pdp-lifestyle-img',
                  widths: '400, 600, 800',
                  sizes: '(min-width: 990px) 33vw, 75vw',
                  loading: 'lazy',
                  alt: block.settings.caption | default: heading
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg pdp-lifestyle-img' }}
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <div class="pdp-lifestyle-caption">{{ block.settings.caption | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP Lifestyle Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Lifestyle inspiration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See how our bedding styles real homes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lifestyle Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Styled in a real home"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Lifestyle Gallery",
      "blocks": [
        { "type": "image", "settings": { "caption": "Styled in a real home" } },
        { "type": "image", "settings": { "caption": "Customer-inspired bedroom look" } },
        { "type": "image", "settings": { "caption": "Layered bedding in a cozy space" } }
      ]
    }
  ]
}
{% endschema %}
