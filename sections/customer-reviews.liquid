{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_image = section.settings.background_image
  assign heading = section.settings.heading | default: 'Customers are saying'
-%}

<div
  class="customer-reviews-section color-{{ section.settings.color_scheme }} gradient"
  {% if bg_image != blank %}
    style="--reviews-bg-image: url('{{ bg_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="customer-reviews__watermark customer-reviews__watermark--left" aria-hidden="true">&ldquo;</div>
  <div class="customer-reviews__watermark customer-reviews__watermark--right" aria-hidden="true">&rdquo;</div>

  <div class="page-width">
    <div class="customer-reviews__header">
      <h2 class="customer-reviews__heading">{{ heading | escape }}</h2>
      <div class="customer-reviews__stars-summary" aria-label="5 star average rating">
        <span class="customer-reviews__star">★</span>
        <span class="customer-reviews__star">★</span>
        <span class="customer-reviews__star">★</span>
        <span class="customer-reviews__star">★</span>
        <span class="customer-reviews__star">★</span>
        <span class="customer-reviews__rating-text">4.9 / 5.0 from verified customers</span>
      </div>
    </div>

    <div class="customer-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="customer-reviews__card" {{ block.shopify_attributes }}>
          <div class="customer-reviews__card-stars">★★★★★</div>
          <p class="customer-reviews__card-text">&ldquo;{{ block.settings.review_text | escape }}&rdquo;</p>
          <div class="customer-reviews__card-author">
            <span class="customer-reviews__author-name">{{ block.settings.author_name | escape }}</span>
            <span class="customer-reviews__verified-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              Verified Buyer
            </span>
          </div>
          {%- if block.settings.product_title != blank -%}
            <div class="customer-reviews__product">{{ block.settings.product_title | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers are saying"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Sarah M."
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The blanket turned out even more beautiful than I imagined! The print quality is so clear, and the fabric is incredibly soft."
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Personalized Cozy Fleece Blanket"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author_name": "Jessica R.",
            "review_text": "I ordered a personalized comforter for my daughter's dorm room. She absolutely loves how warm and cozy it is!",
            "product_title": "Custom Photo Comforter Set"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Michael B.",
            "review_text": "High quality stitching and vibrant colors that didn't fade after the first wash. Truly impressive craftsmanship.",
            "product_title": "Handcrafted Quilt Bedding"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Amanda T.",
            "review_text": "Fast delivery and customer service was super responsive when I had a question about custom sizing.",
            "product_title": "Custom Printed Duvet Cover"
          }
        }
      ]
    }
  ]
}
{% endschema %}
