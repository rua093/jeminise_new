{{ 'component-delivery-estimate.css' | asset_url | stylesheet_tag }}

<div class="pdp-delivery-estimate" id="DeliveryEstimate-{{ section.id }}">
  <div class="pdp-delivery-estimate__header">
    <span class="pdp-delivery-estimate__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </span>
    <span>Estimated Delivery: <strong class="pdp-delivery-estimate__range" id="DeliveryRange-{{ section.id }}">Loading...</strong></span>
  </div>

  <div class="pdp-delivery-timeline">
    <div class="pdp-delivery-step">
      <div class="pdp-delivery-dot">✓</div>
      <p class="pdp-delivery-title">Order Placed</p>
      <span class="pdp-delivery-date" id="DeliveryToday-{{ section.id }}">Today</span>
    </div>
    <div class="pdp-delivery-step">
      <div class="pdp-delivery-dot">2</div>
      <p class="pdp-delivery-title">Custom Crafting</p>
      <span class="pdp-delivery-date" id="DeliveryShips-{{ section.id }}">2-4 days</span>
    </div>
    <div class="pdp-delivery-step">
      <div class="pdp-delivery-dot">3</div>
      <p class="pdp-delivery-title">Delivered</p>
      <span class="pdp-delivery-date" id="DeliveryArrives-{{ section.id }}">7-14 days</span>
    </div>
  </div>
</div>

<script>
  (function initDeliveryDates() {
    const today = new Date();
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    
    function addDays(d, days) {
      const res = new Date(d);
      res.setDate(res.getDate() + days);
      return res;
    }
    
    const dShip = addDays(today, 3);
    const dEarly = addDays(today, 8);
    const dLate = addDays(today, 14);

    const rangeStr = months[dEarly.getMonth()] + ' ' + dEarly.getDate() + ' - ' + months[dLate.getMonth()] + ' ' + dLate.getDate();
    const shipStr = months[dShip.getMonth()] + ' ' + dShip.getDate();
    const todayStr = months[today.getMonth()] + ' ' + today.getDate();

    const rangeEl = document.getElementById('DeliveryRange-{{ section.id }}');
    const todayEl = document.getElementById('DeliveryToday-{{ section.id }}');
    const shipEl = document.getElementById('DeliveryShips-{{ section.id }}');
    const arriveEl = document.getElementById('DeliveryArrives-{{ section.id }}');

    if (rangeEl) rangeEl.textContent = rangeStr;
    if (todayEl) todayEl.textContent = todayStr;
    if (shipEl) shipEl.textContent = shipStr;
    if (arriveEl) arriveEl.textContent = rangeStr;
  })();
</script>
